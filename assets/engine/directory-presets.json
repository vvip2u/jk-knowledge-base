{
  "version": "2.3",
  "note": "目录方案单点数据源。所有文档与脚本一律引用本文件，禁止另抄一份。v2.0 起主分类采用「知识资产角色」范式（12 个顶层目录），行业主题包降级为 topic 备选模式。",
  "paradigm": {
    "name": "知识资产角色分类",
    "principle": "不要只按内容的主题分类，而要区分内容在知识生产过程中扮演的角色。",
    "why": "一份客户访谈录音、一篇访谈分析、一条市场判断、一个被验证的商业假设，讨论的是同一件事，却属于不同层次的知识资产。混在一棵主题树里，必然越用越乱。",
    "chain": "原始信息 → 认知加工 → 实验验证 → 资产沉淀 → 项目应用 → 复盘迭代",
    "six_questions": [
      "我知道什么？（原始资料、事实、调研数据、外部信息）",
      "我如何理解？（整理、分析、思考、假设、模型）",
      "我验证过什么？（实验、客户反馈、市场测试、被证实或推翻的假设）",
      "我创造了什么？（方法论、产品、作品、方案等可复用资产）",
      "我正在做什么？（当前项目、决策、任务及执行结果）",
      "下次如何做得更好？（复盘、经验、失败教训、持续迭代）"
    ],
    "single_home_rule": "一份内容只有一个主要存放位置，但可以拥有多个标签、双向链接和索引入口。禁止把同一文件复制到多个目录。",
    "three_dimensions": {
      "维度一_主目录": "它是什么资产（唯一，互斥，落在 folders）",
      "维度二_主题标签": "它涉及什么（多选，落在 frontmatter 的 l1/l2/l3）",
      "维度三_关系与状态": "它关联什么、进展如何（落在 frontmatter 属性：所属项目、来源文件、关联假设、关联实验、状态、版本）"
    }
  },
  "default_mode": "asset",
  "modes": {
    "asset": {
      "label": "知识资产角色分类（推荐 · 12 顶层目录）",
      "system_layer": {
        "index_dir": "00_系统与索引",
        "moc": "00_系统与索引/00_知识库首页.md",
        "specs_into": "00_系统与索引/03_标签与元数据字典",
        "specs": [
          "元数据规范.md",
          "标签体系.md",
          "原子化笔记标准.md",
          "编号与溯源链.md",
          "置信度标准.md"
        ],
        "templates_into": "00_系统与索引/07_标准模板",
        "templates": [
          {
            "file": "tpl-source-card.md",
            "as": "资料卡模板.md"
          },
          {
            "file": "tpl-research-report.md",
            "as": "研究报告模板.md"
          },
          {
            "file": "tpl-hypothesis-card.md",
            "as": "假设卡模板.md"
          },
          {
            "file": "tpl-experiment-log.md",
            "as": "实验记录模板.md"
          },
          {
            "file": "tpl-knowledge-card.md",
            "as": "知识卡模板.md"
          },
          {
            "file": "tpl-decision-log.md",
            "as": "决策记录模板.md"
          },
          {
            "file": "tpl-retro.md",
            "as": "复盘模板.md"
          },
          {
            "file": "tpl-atom-card.md",
            "as": "原子卡片模板.md"
          }
        ],
        "extra_index": [
          {
            "as": "01_全局知识地图.md",
            "kind": "map",
            "desc": "从行业/客户/产品/商业模式/当前项目多个入口跳转同一批资产的导航页"
          },
          {
            "as": "02_目录分类规则.md",
            "kind": "dirrules",
            "desc": "每个目录放什么、不放什么、命名规则（由脚本从本表生成）"
