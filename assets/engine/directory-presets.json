          {
            "as": "08_命名与版本规范.md",
            "kind": "naming",
            "desc": "文件命名、版本标记、状态字段规范"
          },
          {
            "as": "09_维护及备份规则.md",
            "kind": "maintain",
            "desc": "收件箱清空节奏、复审周期、归档与备份"
          }
        ]
      },
      "core": [
        {
