{
  "name": "jk-knowledge-base",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH Web GUI 知识库插件 / a DSH Web GUI knowledge-base plugin：在设置里新增「JK知识库」子菜单与「启动JK知识库」开关，开启后侧边栏「插件」下方出现「知识库」入口，主页面为左栏菜单 + 执行任务、右栏内容的两栏布局；仪表盘/任务/业务专家/整理报告全部来自宿主真实数据，内置 47 条技能目录、8 条整理规则、16 项体检修复（doctor）与运行可溯源（run/step/token/acceptance）。",
  "license": "MIT",
  "author": "JakeKim@XingHaoTech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvip2u/jk-knowledge-base.git"
  },
  "homepage": "https://github.com/vvip2u/jk-knowledge-base#readme",
  "bugs": {
    "url": "https://github.com/vvip2u/jk-knowledge-base/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web-gui",
    "knowledge-base",
    "sidebar",
    "dashboard"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "host/**",
    "assets/engine/**",
    "assets/maintenance-rules.json",
    "cordis.patch.yml",
    "README.md",
    "DOCTOR.md",
    "PUBLISHING.md",
    "VERIFY-WINDOWS.md",
    "LICENSE",
    "CHANGELOG.md",
    "tools/smoke-test.mjs"
  ],
  "scripts": {
    "test": "node tools/smoke-test.mjs && node tools/doctor-test.mjs && node tools/engine-test.mjs && node tools/skills-test.mjs && node tools/ui-test.mjs",
    "smoke": "node tools/smoke-test.mjs",
    "doctor": "node tools/doctor-test.mjs",
    "engine": "node tools/engine-test.mjs",
    "skills": "node tools/skills-test.mjs",
    "ui": "node tools/ui-test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
